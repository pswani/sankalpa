DEPLOY_ENVIRONMENT=dev
DEPLOY_REGION=us-east-1
LOCAL_DB_PORT=8000
LOCAL_API_PORT=8080
LOCAL_BIND_HOST=127.0.0.1
SANKALPA_DYNAMODB_TABLE=sankalpa-local
