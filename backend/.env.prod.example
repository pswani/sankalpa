DEPLOY_ENVIRONMENT=prod
DEPLOY_RESOURCE_PREFIX=sankalpa
DEPLOY_REGION=us-east-1
DEPLOY_ACCOUNT_ID=REPLACE_WITH_YOUR_12_DIGIT_ACCOUNT_ID
DEPLOY_AWS_PROFILE=default
DEPLOY_MEMORY=1024
DEPLOY_TIMEOUT=90
DEPLOY_CONCURRENCY=2
DEPLOY_ARCHITECTURE=arm64
SANKALPA_TIMEZONE=America/Chicago
SANKALPA_API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN
SANKALPA_ASSISTANT_ENABLED=false
SANKALPA_LLM_PROVIDER=fake
SANKALPA_LLM_API_KEY=
SANKALPA_LLM_MODEL=gpt-6-luna
SANKALPA_LLM_REASONING_EFFORT=none
SANKALPA_LLM_TIMEOUT=PT20S
SANKALPA_ASSISTANT_RUNS_PER_MINUTE=2
SANKALPA_ASSISTANT_RUNS_PER_DAY=20
# Optional account-wide monthly $5 budget; supplying an address opts into alerts.
DEPLOY_BUDGET_EMAIL=
