# Copy this file to .env and keep that local file out of source control.
SANKALPA_TIMEZONE=America/Chicago

# Conversational Sankalpa
SANKALPA_ASSISTANT_ENABLED=true
SANKALPA_LLM_PROVIDER=openai
SANKALPA_LLM_MODEL=gpt-6-luna
SANKALPA_LLM_API_KEY=replace-with-your-openai-api-key
SANKALPA_LLM_TIMEOUT=PT30S
SANKALPA_LLM_REASONING_EFFORT=none
SANKALPA_ASSISTANT_RUNS_PER_MINUTE=30

# Optional protection for /api/v1 when the service is reachable off-machine.
SANKALPA_API_TOKEN=
